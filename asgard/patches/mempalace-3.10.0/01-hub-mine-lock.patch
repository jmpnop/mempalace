+++ b/mempalace/hub_lock.py	2026-11-20 08:15:02
@@ -0,0 +1,103 @@
+"""Per-batch exclusivity for long-running hub tool calls (local patch).
+
+The HTTP hub serializes palace access with a readers-writer lock
+(``mcp_server.http._HTTP_REQUEST_LOCK``): reads share it, writes take it
+exclusively. A ``mempalace_mine`` call used to take it exclusively for the
+whole run, so a mine of a large project stalled every other session's tool
+calls for minutes.
+
+A long operation instead holds the lock *shared* for its whole run — so all
+its own reads, collection opens and cache work count as a reader — and steps
+up to *exclusive* only around each storage write batch and around steps that
+replace process-wide storage handles. Other sessions' reads run alongside the
+mine; their writes run between the mine's write batches, never during one.
+
+Outside a long operation (every other tool, the CLI, tests) both context
+managers are no-ops: the dispatcher already holds the right lock mode, and
+the lock is not re-entrant, so re-acquiring it would self-deadlock.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import threading
+
+_rw = None  # the hub's _RWLock, installed by mcp_server.http
+_tls = threading.local()  # .mode: None | "r" (long operation) | "w" (inside a write batch)
+_active_guard = threading.Lock()
+_active = 0  # long operations running in this process (any thread)
+
+
+def long_operation_active() -> bool:
+    """True while any thread of this process is inside ``long_operation()``.
+
+    The chroma backend uses this to tell its own writes apart from an external
+    rebuild: a long operation keeps collection handles open across its write
+    batches, so tearing the shared client down underneath it breaks the run.
+    """
+    return _active > 0
+
+
+def in_long_operation_thread() -> bool:
+    """True when the calling thread is itself running a long operation."""
+    return getattr(_tls, "mode", None) is not None
+
+
+def another_thread_in_long_operation() -> bool:
+    """True when a long operation is running on some *other* thread of this process."""
+    return long_operation_active() and not in_long_operation_thread()
+
+
+def install(rw) -> None:
+    """Register the hub's readers-writer lock. Called once by the HTTP transport."""
+    global _rw
+    _rw = rw
+
+
+@contextlib.contextmanager
+def long_operation():
+    """Run the body holding the hub lock shared; ``exclusive()`` inside it upgrades per batch."""
+    if _rw is None or getattr(_tls, "mode", None) is not None:
+        yield
+        return
+    global _active
+    _rw.acquire_read()
+    _tls.mode = "r"
+    with _active_guard:
+        _active += 1
+    try:
+        yield
+    finally:
+        with _active_guard:
+            _active -= 1
+        mode = _tls.mode
+        _tls.mode = None
+        if mode == "r":
+            _rw.release_read()
+        elif mode == "w":
+            _rw.release_write()
+
+
+@contextlib.contextmanager
+def exclusive():
+    """Inside a long operation: hold the hub lock exclusively for the body.
+
+    Releases the shared hold first (the lock cannot upgrade in place), so a
+    waiting writer from another session may run before this batch; the shared
+    hold is re-taken afterwards. No-op outside a long operation or when this
+    thread is already exclusive.
+    """
+    if getattr(_tls, "mode", None) != "r":
+        yield
+        return
+    _rw.release_read()
+    _tls.mode = None
+    _rw.acquire_write()
+    _tls.mode = "w"
+    try:
+        yield
+    finally:
+        _rw.release_write()
+        _tls.mode = None
+        _rw.acquire_read()
+        _tls.mode = "r"
